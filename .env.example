# Groq (required for supplier scoring — free at console.groq.com)
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

# Slack (optional — notifications print to stdout without a token)
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...

# Database
# Local dev (default):
DATABASE_URL=sqlite+aiosqlite:///./procurement.db
# Docker Compose / production (PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://procurement:procurement@db:5432/procurement

# Storage paths (override in production if using a mounted volume)
CHROMA_PERSIST_DIR=./data/chroma
KNOWLEDGE_BASE_DIR=./data/knowledge_base
SEED_DIR=./data/seed

# Frontend origin — used for Slack notification links
DASHBOARD_BASE_URL=http://localhost:5173

# Pilot
DEFAULT_PILOT_TEAM=pilot-alpha
PROMPT_LIBRARY_VERSION=v1.0

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
# Production: set to your deployed frontend URL
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
